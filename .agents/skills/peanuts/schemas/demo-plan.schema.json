{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/demo-plan.schema.json",
  "title": "Project Demonstration Plan",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "project_id": {
      "type": "string",
      "pattern": "^[a-z0-9]+(?:-[a-z0-9]+)*$"
    },
    "status": {
      "enum": [
        "draft",
        "provisional",
        "approved",
        "not_applicable"
      ]
    },
    "objective": {
      "type": "string",
      "minLength": 8,
      "maxLength": 1000
    },
    "audience": {
      "type": "string",
      "minLength": 3,
      "maxLength": 500
    },
    "duration_minutes": {
      "type": "integer",
      "minimum": 0,
      "maximum": 120
    },
    "core_scenario": {
      "type": "string",
      "minLength": 8,
      "maxLength": 1500
    },
    "environment_prerequisites": {
      "type": "array",
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "steps": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "step_id": {
            "type": "string",
            "pattern": "^DEMO-[0-9]{2}$"
          },
          "narration": {
            "type": "string",
            "minLength": 5,
            "maxLength": 500
          },
          "action": {
            "type": "string",
            "minLength": 5,
            "maxLength": 500
          },
          "expected_observation": {
            "type": "string",
            "minLength": 5,
            "maxLength": 500
          },
          "requirement_ids": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "pattern": "^REQ-[0-9]{3,5}$"
            },
            "uniqueItems": true
          }
        },
        "required": [
          "step_id",
          "narration",
          "action",
          "expected_observation",
          "requirement_ids"
        ]
      }
    },
    "demo_claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "claim": {
            "type": "string",
            "minLength": 8,
            "maxLength": 500
          },
          "claim_strength": {
            "enum": [
              "demonstrated",
              "measured",
              "illustrative",
              "hypothetical"
            ]
          },
          "evidence_refs": {
            "type": "array",
            "items": {
              "type": "object",
              "additionalProperties": false,
              "properties": {
                "record_type": {
                  "enum": [
                    "source",
                    "claim",
                    "assumption",
                    "decision",
                    "research_finding",
                    "opportunity",
                    "analogy",
                    "council_finding",
                    "artifact",
                    "external_requirement",
                    "acceptance_test",
                    "assumption_test",
                    "nuts_run",
                    "evaluation_result"
                  ]
                },
                "record_id": {
                  "type": "string",
                  "minLength": 3
                },
                "note": {
                  "type": "string",
                  "maxLength": 500
                }
              },
              "required": [
                "record_type",
                "record_id"
              ]
            },
            "uniqueItems": true
          }
        },
        "required": [
          "claim",
          "claim_strength",
          "evidence_refs"
        ]
      }
    },
    "data_strategy": {
      "enum": [
        "synthetic",
        "fixture",
        "deidentified",
        "public",
        "authorized_test_data",
        "not_applicable"
      ]
    },
    "privacy_and_safety_controls": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 8,
        "maxLength": 500
      }
    },
    "failure_plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "trigger": {
          "type": "string",
          "minLength": 5
        },
        "response": {
          "type": "string",
          "minLength": 5
        },
        "fallback": {
          "type": "string",
          "minLength": 5
        },
        "stop_condition": {
          "type": "string",
          "minLength": 5
        }
      },
      "required": [
        "trigger",
        "response",
        "fallback",
        "stop_condition"
      ]
    },
    "limitations_to_disclose": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "owner": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "not_applicable_rationale": {
      "type": "string",
      "minLength": 12,
      "maxLength": 1000
    }
  },
  "required": [
    "schema_version",
    "project_id",
    "status",
    "objective",
    "audience",
    "duration_minutes",
    "core_scenario",
    "environment_prerequisites",
    "steps",
    "demo_claims",
    "data_strategy",
    "privacy_and_safety_controls",
    "failure_plan",
    "limitations_to_disclose",
    "owner",
    "created_at",
    "updated_at"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "approved_by",
          "approved_at"
        ]
      }
    },
    {
      "if": {
        "properties": {
          "status": {
            "const": "not_applicable"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "not_applicable_rationale"
        ]
      }
    }
  ]
}
