{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Friday capability contract",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "capability_id",
    "required_inputs",
    "optional_inputs",
    "outputs",
    "required_tools",
    "optional_tools",
    "required_permissions",
    "optional_permissions",
    "failure_behavior",
    "handoff",
    "execution_policy"
  ],
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "capability_id": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9-]*$"
    },
    "execution_policy": {
      "const": "host-mediated-no-auto-execution"
    },
    "required_inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "optional_inputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "outputs": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "required_tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "optional_tools": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "required_permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "optional_permissions": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 120
      }
    },
    "failure_behavior": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000
    },
    "handoff": {
      "type": "string",
      "minLength": 20,
      "maxLength": 2000
    }
  }
}
