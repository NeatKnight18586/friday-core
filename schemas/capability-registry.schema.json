{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/capability-registry.schema.json",
  "title": "Friday Capability Registry",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "registry_version": {
      "type": "string",
      "minLength": 3
    },
    "purpose": {
      "type": "string",
      "minLength": 20
    },
    "capabilities": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/capability"
      },
      "maxItems": 128
    }
  },
  "required": [
    "schema_version",
    "registry_version",
    "purpose",
    "capabilities"
  ],
  "$defs": {
    "capability": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "id": {
          "type": "string",
          "pattern": "^[a-z][a-z0-9-]*$"
        },
        "display_name": {
          "type": "string",
          "minLength": 2
        },
        "kind": {
          "enum": [
            "skill",
            "harness",
            "agent",
            "workflow",
            "toolset"
          ]
        },
        "lifecycle": {
          "enum": [
            "planned",
            "active",
            "deprecated",
            "retired"
          ]
        },
        "maturity": {
          "enum": [
            "experimental",
            "prototype",
            "validated",
            "production"
          ]
        },
        "canonical_path": {
          "type": "string",
          "minLength": 1
        },
        "skill_file": {
          "type": "string",
          "minLength": 1
        },
        "domains": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "intents": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "default_mode": {
          "enum": [
            "quick",
            "standard",
            "deep"
          ]
        },
        "supported_modes": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "enum": [
              "quick",
              "standard",
              "deep"
            ]
          }
        },
        "host_profiles": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "host": {
                "type": "string",
                "pattern": "^[a-z][a-z0-9-]*$"
              },
              "status": {
                "enum": [
                  "planned",
                  "ready-for-test",
                  "verified",
                  "manual-fallback",
                  "conditional",
                  "not-supported"
                ]
              },
              "discovery_path": {
                "type": [
                  "string",
                  "null"
                ]
              },
              "note": {
                "type": "string",
                "minLength": 5
              }
            },
            "required": [
              "host",
              "status",
              "discovery_path",
              "note"
            ]
          }
        },
        "permissions_profile": {
          "type": "string",
          "minLength": 5
        },
        "evaluation_refs": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^EVAL-[0-9]{3,5}$"
          }
        },
        "summary": {
          "type": "string",
          "minLength": 20,
          "maxLength": 280
        },
        "dependencies": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "pattern": "^[a-z][a-z0-9-]*$"
          }
        },
        "exclusions": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 3
          }
        },
        "entrypoint": {
          "type": "string",
          "minLength": 1
        },
        "contract_file": {
          "type": "string",
          "minLength": 1
        }
      },
      "required": [
        "id",
        "display_name",
        "kind",
        "lifecycle",
        "maturity",
        "canonical_path",
        "domains",
        "intents",
        "default_mode",
        "supported_modes",
        "host_profiles",
        "permissions_profile",
        "evaluation_refs",
        "summary",
        "dependencies",
        "entrypoint"
      ],
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "skill"
              }
            },
            "required": [
              "kind"
            ]
          },
          "then": {
            "required": [
              "skill_file"
            ]
          }
        }
      ]
    }
  }
}
