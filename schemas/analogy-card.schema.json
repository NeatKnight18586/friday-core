{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/analogy-card.schema.json",
  "title": "NUTS Analogy Card",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "analogy_id": {
      "type": "string",
      "pattern": "^ANL-[0-9]{4,6}$"
    },
    "title": {
      "type": "string",
      "minLength": 5,
      "maxLength": 240
    },
    "status": {
      "enum": [
        "candidate",
        "researching",
        "retained_for_test",
        "rejected",
        "archived"
      ]
    },
    "source_domain": {
      "enum": [
        "nature_biology",
        "history_civilization",
        "engineering_physical",
        "culture_social",
        "economics_operations",
        "existing_product_process",
        "other"
      ]
    },
    "source_system": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "name": {
          "type": "string",
          "minLength": 2
        },
        "original_context": {
          "type": "string",
          "minLength": 10
        },
        "period_or_version": {
          "type": [
            "string",
            "null"
          ]
        },
        "original_function": {
          "type": "string",
          "minLength": 10
        },
        "actors_components": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 2
          }
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "mechanism_description": {
          "type": "string",
          "minLength": 20
        },
        "feedback_and_failure": {
          "type": "string",
          "minLength": 5
        }
      },
      "required": [
        "name",
        "original_context",
        "period_or_version",
        "original_function",
        "actors_components",
        "constraints",
        "mechanism_description",
        "feedback_and_failure"
      ]
    },
    "source_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^SRC-[0-9]{4,6}$"
      }
    },
    "claim_ids": {
      "type": "array",
      "minItems": 1,
      "uniqueItems": true,
      "items": {
        "type": "string",
        "pattern": "^CLM-[0-9]{4,6}$"
      }
    },
    "target_problem": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "problem_statement": {
          "type": "string",
          "minLength": 10
        },
        "target_function": {
          "type": "string",
          "minLength": 5
        },
        "context": {
          "type": "string",
          "minLength": 5
        },
        "constraints": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "required": [
        "problem_statement",
        "target_function",
        "context",
        "constraints"
      ]
    },
    "relationship_mappings": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "properties": {
          "source_relationship": {
            "type": "string",
            "minLength": 5
          },
          "target_correspondence": {
            "type": "string",
            "minLength": 5
          },
          "mapping_quality": {
            "enum": [
              "strong",
              "partial",
              "weak",
              "unmapped"
            ]
          },
          "explanation": {
            "type": "string",
            "minLength": 10
          }
        },
        "required": [
          "source_relationship",
          "target_correspondence",
          "mapping_quality",
          "explanation"
        ]
      }
    },
    "abstracted_principle": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1200
    },
    "transfer_hypothesis": {
      "type": "string",
      "minLength": 20,
      "maxLength": 1600
    },
    "mismatch_analysis": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "alternatives_considered": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 3
      }
    },
    "failure_modes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "string",
        "minLength": 5
      }
    },
    "test_plan": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "smallest_test": {
          "type": "string",
          "minLength": 10
        },
        "observable_measure": {
          "type": "string",
          "minLength": 5
        },
        "success_signal": {
          "type": "string",
          "minLength": 5
        },
        "failure_signal": {
          "type": "string",
          "minLength": 5
        },
        "time_or_resource_limit": {
          "type": "string",
          "minLength": 3
        }
      },
      "required": [
        "smallest_test",
        "observable_measure",
        "success_signal",
        "failure_signal",
        "time_or_resource_limit"
      ]
    },
    "rights_and_attribution": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "attribution_note": {
          "type": "string",
          "minLength": 3
        },
        "copyright_license_status": {
          "enum": [
            "not_assessed",
            "attribution_recorded",
            "permission_or_license_check_needed",
            "cleared_for_intended_use",
            "not_applicable"
          ]
        },
        "patent_or_prior_art_status": {
          "enum": [
            "not_assessed",
            "preliminary_search_done",
            "expert_review_needed",
            "not_applicable"
          ]
        },
        "cultural_knowledge_status": {
          "enum": [
            "not_applicable",
            "context_review_needed",
            "consultation_or_permission_needed",
            "consulted_or_permissioned"
          ]
        }
      },
      "required": [
        "attribution_note",
        "copyright_license_status",
        "patent_or_prior_art_status",
        "cultural_knowledge_status"
      ]
    },
    "assessment": {
      "type": "object",
      "additionalProperties": false,
      "properties": {
        "source_accuracy": {
          "enum": [
            "verified",
            "partially_verified",
            "unverified",
            "contested",
            "not_assessed"
          ]
        },
        "functional_relevance": {
          "enum": [
            "strong",
            "adequate",
            "weak",
            "unknown"
          ]
        },
        "relational_mapping": {
          "enum": [
            "strong",
            "adequate",
            "weak",
            "unknown"
          ]
        },
        "context_fit": {
          "enum": [
            "strong",
            "adequate",
            "weak",
            "unknown"
          ]
        },
        "incremental_value": {
          "enum": [
            "strong",
            "adequate",
            "weak",
            "unknown"
          ]
        },
        "testability": {
          "enum": [
            "strong",
            "adequate",
            "weak",
            "unknown"
          ]
        },
        "disposition": {
          "enum": [
            "promising",
            "plausible_needs_test",
            "weak_transfer",
            "rejected"
          ]
        },
        "rationale": {
          "type": "string",
          "minLength": 20
        },
        "reviewed_at": {
          "type": "string",
          "format": "date-time"
        }
      },
      "required": [
        "source_accuracy",
        "functional_relevance",
        "relational_mapping",
        "context_fit",
        "incremental_value",
        "testability",
        "disposition",
        "rationale",
        "reviewed_at"
      ]
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "method_version": {
      "type": "string",
      "minLength": 3
    }
  },
  "required": [
    "schema_version",
    "analogy_id",
    "title",
    "status",
    "source_domain",
    "source_system",
    "source_ids",
    "claim_ids",
    "target_problem",
    "relationship_mappings",
    "abstracted_principle",
    "transfer_hypothesis",
    "mismatch_analysis",
    "alternatives_considered",
    "failure_modes",
    "test_plan",
    "rights_and_attribution",
    "assessment",
    "created_at",
    "updated_at",
    "method_version"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "retained_for_test"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "properties": {
          "assessment": {
            "properties": {
              "source_accuracy": {
                "enum": [
                  "verified",
                  "partially_verified"
                ]
              },
              "functional_relevance": {
                "enum": [
                  "strong",
                  "adequate"
                ]
              },
              "relational_mapping": {
                "enum": [
                  "strong",
                  "adequate"
                ]
              },
              "testability": {
                "enum": [
                  "strong",
                  "adequate"
                ]
              },
              "disposition": {
                "enum": [
                  "promising",
                  "plausible_needs_test"
                ]
              }
            }
          }
        }
      }
    }
  ]
}
