{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://friday.local/schemas/artifact-record.schema.json",
  "title": "Project Artifact Record",
  "type": "object",
  "additionalProperties": false,
  "properties": {
    "schema_version": {
      "const": "1.0.0"
    },
    "artifact_id": {
      "type": "string",
      "pattern": "^ART-[0-9]{4,6}$"
    },
    "title": {
      "type": "string",
      "minLength": 3,
      "maxLength": 180
    },
    "artifact_type": {
      "enum": [
        "project_brief",
        "prd",
        "technical_design",
        "build_plan",
        "demo_plan",
        "diagram",
        "prototype",
        "decision_record",
        "research",
        "evaluation",
        "other",
        "demo_plan_data"
      ]
    },
    "path": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500,
      "pattern": "^(?!/)(?!.*\\\\)(?!.*(?:^|/)\\.\\.(?:/|$)).+$"
    },
    "status": {
      "enum": [
        "draft",
        "in_review",
        "reviewed",
        "approved",
        "superseded",
        "archived"
      ]
    },
    "version": {
      "type": "string",
      "pattern": "^[0-9]+\\.[0-9]+\\.[0-9]+(?:-[0-9A-Za-z.-]+)?$"
    },
    "owner": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "updated_at": {
      "type": "string",
      "format": "date-time"
    },
    "approved_by": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "approved_at": {
      "type": "string",
      "format": "date-time"
    },
    "sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "linked_requirement_ids": {
      "type": "array",
      "items": {
        "type": "string",
        "pattern": "^REQ-[0-9]{3,5}$"
      },
      "uniqueItems": true
    },
    "notes": {
      "type": "string",
      "maxLength": 1000
    }
  },
  "required": [
    "schema_version",
    "artifact_id",
    "title",
    "artifact_type",
    "path",
    "status",
    "version",
    "owner",
    "created_at",
    "updated_at"
  ],
  "allOf": [
    {
      "if": {
        "properties": {
          "status": {
            "const": "approved"
          }
        },
        "required": [
          "status"
        ]
      },
      "then": {
        "required": [
          "approved_by",
          "approved_at"
        ]
      }
    }
  ]
}
